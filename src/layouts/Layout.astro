---
import "@fontsource/instrument-serif/400.css"
import "@fontsource/instrument-serif/400-italic.css"
import "@fontsource-variable/inter-tight"
import "@/styles/global.css"

import { cv } from "@/data/cv"

interface Props {
  title: string
}

const { title } = Astro.props

const { image, summary, url } = cv.basics
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={summary} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="image" href={image} />

    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />

    <meta name="twitter:card" content="summary" />
    <meta property="og:image" content={new URL(image, url).href} />
    <meta name="twitter:image" content={new URL(image, url).href} />
    <meta property="twitter:domain" content={url.split("//")[1] ?? ""} />
    <meta property="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={summary} />

    <script is:inline>
      ;(() => {
        const root = document.documentElement
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return
        root.classList.add("motion")
        // Safety net: if the motion module never boots, show the content anyway.
        setTimeout(() => {
          if (!root.classList.contains("motion-ready")) root.classList.remove("motion")
        }, 3000)
      })()
    </script>
  </head>
  <body>
    <slot />
    <script>
      import "@/scripts/motion"
    </script>
  </body>
</html>
