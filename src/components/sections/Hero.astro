---
import { cv, CV_PDF } from "@/data/cv"
import SocialLinks from "@/components/SocialLinks.astro"
import WorldMap from "@/icons/WorldMap.astro"

const { name, label, headline, image, location, availability } = cv.basics
---

<section class="hero" id="inicio">
  <div class="container grid">
    <div class="intro">
      <p class="eyebrow" data-reveal>{name}</p>
      <h1 data-split="load">{headline}</h1>
      <p class="label" data-reveal data-delay="0.4">{label}</p>
      <p class="location" data-reveal data-delay="0.5">
        <WorldMap />
        {location.city}, {location.region} · {availability}
      </p>
      <div class="actions" data-reveal data-delay="0.6">
        <a class="btn btn-primary" href={CV_PDF} type="application/pdf" download>Descargar CV<span class="sr-only"> (PDF)</span></a>
        <a class="btn" href="#contacto">Contactar</a>
        <SocialLinks />
      </div>
    </div>
    <figure data-clip>
      <img src={image} alt={`Retrato de ${name}`} width="320" height="400" />
    </figure>
  </div>
  <a class="scroll-hint" href="#impacto" aria-label="Ir a la sección de impacto"><span></span></a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding-block: 7rem 4rem;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 7.5rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 0.95;
    text-wrap: balance;
  }

  .label {
    font-size: clamp(1rem, 1.6vw, 1.2rem);
  }

  .location {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  figure {
    width: clamp(180px, 24vw, 320px);
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.6s;
  }

  figure:hover img {
    filter: none;
  }

  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    translate: -50% 0;
    display: flex;
    justify-content: center;
    width: 24px;
    height: 40px;
    padding-top: 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .scroll-hint span {
    width: 3px;
    height: 8px;
    border-radius: 2px;
    background: var(--accent);
    animation: scroll-hint 1.8s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  @keyframes scroll-hint {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (width <= 700px) {
    .grid {
      grid-template-columns: 1fr;
    }

    figure {
      order: -1;
      width: 140px;
    }

    .scroll-hint {
      display: none;
    }
  }
</style>
