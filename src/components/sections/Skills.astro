---
import Section from "@/components/Section.astro"
import { cv } from "@/data/cv"

const { skills } = cv
const { stack } = cv.basics
---

<Section id="competencias" index="04" title="Competencias">
  <div class="groups">
    {
      skills.map(({ name, keywords }) => (
        <div>
          <h3 data-reveal>{name}</h3>
          <ul class="chips" data-stagger>
            {keywords.map((keyword) => (
              <li>{keyword}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>

<div class="marquee" role="region" aria-label="Stack técnico">
  <div class="track">
    {
      [...stack, ...stack].map((item, i) => (
        <span aria-hidden={i >= stack.length ? "true" : undefined}>{item}</span>
      ))
    }
  </div>
</div>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 3rem 4rem;
  }

  h3 {
    margin-bottom: 1rem;
    font-size: 1.1rem;
    font-weight: 500;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chips li {
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: #cfcfcf;
    font-size: 0.88rem;
    transition:
      border-color 0.3s,
      color 0.3s;
  }

  .chips li:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .marquee {
    overflow: hidden;
    padding-block: 1.5rem;
    border-block: 1px solid var(--line);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  .marquee:hover .track {
    animation-play-state: paused;
  }

  .track span {
    padding-inline: 1.5rem;
    color: var(--muted);
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    white-space: nowrap;
  }

  .track span::after {
    content: "✦";
    margin-left: 3rem;
    color: var(--accent);
    font-size: 0.5em;
    vertical-align: middle;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      flex-wrap: wrap;
      width: auto;
      animation: none;
    }

    .track span[aria-hidden="true"] {
      display: none;
    }

    .marquee {
      mask-image: none;
    }
  }
</style>
