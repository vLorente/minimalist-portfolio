---
import Section from "@/components/Section.astro"
import GitHub from "@/icons/GitHub.astro"
import { cv } from "@/data/cv"

const { projects } = cv
---

<Section id="proyectos" index="05" title="Proyectos">
  <p class="intro" data-reveal>
    Proyectos personales donde sigo construyendo con mis propias manos: producto de principio a fin,
    del diseño al despliegue.
  </p>
  <ul class="grid" data-stagger>
    {
      projects.map(({ name, description, highlights, url, github, isActive }) => (
        <li>
          <article class="card">
            <header>
              <h3>
                <a href={url} target="_blank" rel="noopener noreferrer">
                  {name}
                  <span aria-hidden="true">↗</span>
                </a>
              </h3>
              {isActive && <span class="badge">Activo</span>}
            </header>
            <p class="desc">{description}</p>
            <ul class="tags">
              {highlights.slice(0, 5).map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            {github && (
              <a class="code" href={github} target="_blank" rel="noopener noreferrer">
                <GitHub /> Código
              </a>
            )}
          </article>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .intro {
    max-width: 60ch;
    margin-bottom: 2.5rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.25rem;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition:
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s;
  }

  .card:hover {
    border-color: var(--accent);
    transform: translateY(-6px);
  }

  .card header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  h3 {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 400;
    line-height: 1.05;
  }

  /* Stretched link: the whole card is clickable. */
  h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  h3 a span {
    display: inline-block;
    margin-left: 0.35rem;
    color: var(--accent);
    font-size: 0.6em;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card:hover h3 a span {
    transform: translate(3px, -3px);
  }

  .badge {
    padding: 0.25rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 999px;
    color: var(--accent);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .desc {
    flex: 1;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tags li {
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: var(--chip);
    color: var(--text-soft);
    font-size: 0.75rem;
  }

  .code {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .code:hover {
    color: var(--text);
  }
</style>
